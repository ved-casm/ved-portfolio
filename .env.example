# ---- /contact emails (app/api/contact/route.ts) ----
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# where briefs are delivered (defaults to SMTP_USER)
CONTACT_TO=
# public site URL, used for the logo and links in the thank-you email
SITE_URL=
